#!/bin/sh
# push 전에 두 가지를 본다. 절차는 AGENTS.md의 "상태판" 절과 knowledge/production.md에 있다.
# 1. 막는 확인이 실패하면 push를 막는다. 확인 명령은 CHECK에 적는다. 비어 있으면 아무것도 하지 않는다.
#    프로젝트가 정하는 곳이다. 예: CHECK='npm run check'
#    한계: 지금 작업 트리를 검사하므로 push하는 커밋과 다를 수 있다(커밋하지 않은 변경이 있으면 결과가 달라진다).
CHECK=''
if [ -n "$CHECK" ] && ! sh -c "$CHECK" >/dev/null 2>&1; then
  echo "막음: '$CHECK'가 실패했다. 고친 뒤 다시 push한다(실패 내용은 직접 돌려 본다)." >&2
  exit 1
fi

# 2. 상태판 이슈가 마지막 커밋보다 먼저 갱신됐으면 알린다. 이것은 막지 않는다. 상태판을 찾지 못하거나 읽지 못해도
#    알리기만 하고 넘어간다.
#    상태판은 제목이 "진행 상태판"으로 끝나는 열린 이슈다. 번호는 저장소마다 다를 수 있어 제목으로 찾는다.
skip() {
  echo "알림: $1 상태판 검사를 건너뛴다.${2:+ $2}" >&2
  exit 0
}
command -v gh >/dev/null 2>&1 || skip "gh가 없어"
ISSUE=$(gh issue list --state open --limit 100 --json number,title \
  --jq '[.[] | select(.title | endswith("진행 상태판"))][0].number // empty' 2>/dev/null) ||
  skip "이슈 목록을 읽지 못해"
[ -n "$ISSUE" ] || skip "제목이 \"진행 상태판\"으로 끝나는 열린 이슈를 찾지 못해" "상태판 제목을 \"<이름> 진행 상태판\"으로 맞춘다."
updated=$(gh issue view "$ISSUE" --json updatedAt --jq .updatedAt 2>/dev/null) || skip "상태판(#${ISSUE})을 읽지 못해"
issue_ts=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$updated" +%s 2>/dev/null || date -u -d "$updated" +%s 2>/dev/null) ||
  skip "상태판(#${ISSUE})의 갱신 시각을 읽지 못해"
commit_ts=$(git log -1 --format=%ct)
if [ "$issue_ts" -lt "$commit_ts" ]; then
  echo "알림: 상태판 이슈(#${ISSUE})의 본문이 마지막 커밋보다 오래됐다. 본문을 현재 상태에 맞게 고쳐 쓴다." >&2
fi
exit 0
