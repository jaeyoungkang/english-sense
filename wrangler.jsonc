{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-sense",
  "main": "worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "english-sense"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA_LIMITER",
        "class_name": "DailyQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DailyQuota"
      ]
    }
  ],
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_EFFORT": "low",
    "PER_IP_PER_DAY": "30",
    "GLOBAL_PER_DAY": "600"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "english.artificialmind.kr",
      "custom_domain": true,
      "zone_name": "artificialmind.kr"
    },
    {
      "pattern": "mth-english-api.artificialmind.kr",
      "custom_domain": true,
      "zone_name": "artificialmind.kr"
    }
  ]
}
